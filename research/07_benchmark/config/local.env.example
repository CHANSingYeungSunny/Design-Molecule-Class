# Copy this file to  config/local.env  and fill in your own values.
# config/local.env is gitignored and is never read into any report, log or
# run record. Do not commit it and do not paste its contents into a document
# or a chat.
#
# Every value below is genuinely required before `smoke` or `main` will start.
# Nothing is guessed on your behalf.

# 1. API key for THIS EXPERIMENT.
#
#    Create it in the Model Studio console for the ordinary model API, in the
#    SAME region as BMB_REGION (a Model Studio key is bound to its region).
#
#    Use a key for the normal pay-as-you-go model API, NOT a Token Plan
#    (个人版) key. The Token Plan terms restrict it to interactive use inside
#    coding and agent tools and forbid "automation scripts, custom application
#    backends, or any non-interactive batch calling scenario". This benchmark
#    is a batch script, so the client refuses that host outright.
#
#    This variable is separate from anything Claude Code itself uses.
BMB_API_KEY=

# 2. Which region the key belongs to:
#    beijing | singapore | hongkong | us_virginia | japan_tokyo
BMB_REGION=beijing

# 3. The standard Model Studio OpenAI-compatible base_url for that region.
#    Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
BMB_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 4. The exact model id, copied from your region's model list.
#    Verified available in Beijing on 2026-10-06.
BMB_MODEL_ID=deepseek-v4.1-flash