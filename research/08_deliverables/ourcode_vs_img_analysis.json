  "hypotheses": [
    {
      "claim": "The implicit-hydrogen rule (explicit_hs=None) makes the Our Code payload harder to count from than a picture in which every heavy atom is drawn.",
      "status": "NOT TESTED",
      "how_to_test": "Our Code v2 that states the hydrogen count explicitly for every atom, scored on dev only; one factor changed at a time."
    },
    {
      "claim": "Atom-id labels inside the Our Code text are read as significant, so the model reasons about the ids rather than the chemistry.",
      "status": "NOT TESTED",
      "how_to_test": "v2 with opaque sequential ids and an explicit note that ids carry no chemical meaning. NOTE: ids must not encode element counts, and Identity positives must still differ as text."
    },
    {
      "claim": "The img arm benefits from the depiction itself: element symbols and the bond skeleton are perceived at once, whereas a long record list must be parsed sequentially.",
      "status": "NOT TESTED",
      "how_to_test": "Compare against SMILES (short, sequential) — SMILES outscores Our Code on T3 as well, which is consistent with a parsing-cost effect but does not establish it."
    }
